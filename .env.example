# Mẫu biến môi trường. Sao chép thành .env rồi điền key vào .env (KHÔNG điền vào file này).
# .env đã nằm trong .gitignore; không commit, không dán key vào chat.

# Blockscout PRO API (đăng ký: https://dev.blockscout.com), key bắt đầu bằng "proapi_"
BLOCKSCOUT_API_KEY=

# Helius (đăng ký: https://dashboard.helius.dev), dùng cho Solana
HELIUS_API_KEY=

# dRPC (đăng ký: https://drpc.org), dùng để đọc log lịch sử Base
DRPC_API_KEY=
